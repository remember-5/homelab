# Copy to .env and set random secrets. Do not commit the real .env file.
DATABASE_URL=postgresql://postgres:ChangeThisPasswordImmediately@postgres:5432/postgres
SALT=ChangeThisRandomSalt
ENCRYPTION_KEY=GenerateWithOpensslRandHex32
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=ChangeThisMinioSecret
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=ChangeThisMinioSecret
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=ChangeThisMinioSecret
REDIS_AUTH=ChangeThisRedisPassword
NEXTAUTH_SECRET=GenerateWithOpensslRandHex32
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=ChangeThisAdminPassword
CLICKHOUSE_PASSWORD=ChangeThisClickHousePassword
MINIO_ROOT_PASSWORD=ChangeThisMinioPassword
POSTGRES_PASSWORD=ChangeThisPostgresPassword
