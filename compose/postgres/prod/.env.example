# Set all passwords and ports before production deployment. Do not commit the real .env file.
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=ChangeThisPasswordImmediately
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=500
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_MIN_POOL_SIZE=5
PGBOUNCER_RESERVE_POOL_SIZE=5
